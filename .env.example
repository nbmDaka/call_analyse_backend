# Copy this file to .env for local development. Do not use these values in production.
APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://call_analyse:call_analyse@postgres:5432/call_analyse?sslmode=disable
REDIS_ADDR=redis:6379
POSTGRES_DB=call_analyse
POSTGRES_USER=call_analyse
POSTGRES_PASSWORD=call_analyse

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=call-audio
MINIO_USE_SSL=false

JWT_ACCESS_SECRET=development-access-secret-change-me
JWT_REFRESH_SECRET=development-refresh-secret-change-me
# Access tokens are capped at 1h; refresh tokens must be longer-lived.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

AI_MODE=auto
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash
PROVIDER_TIMEOUT=60s
MAX_UPLOAD_BYTES=104857600

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=development-admin-change-me
